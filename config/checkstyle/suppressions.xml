<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
        "-//Puppy Crawl//DTD Suppressions 1.1//EN"
        "http://www.puppycrawl.com/dtds/suppressions_1_1.dtd">

<suppressions>

    <!-- Suppress strict duplicate code checking -->
    <suppress checks="StrictDuplicateCode" files="\.java" lines="1-15"/>

    <!-- Exclude implementation classes from JavaDoc checks -->
    <suppress checks="Javadoc(Package|Method|Type|Variable)" files="io[\\/]microraft[\\/]impl[\\/]"/>
    <suppress checks="Javadoc(Package|Method|Type|Variable)" files="io[\\/]microraft[\\/]tutorial[\\/]"/>
    <suppress checks="Javadoc(Package|Method|Type|Variable)" files="io[\\/]microraft[\\/]faulttolerance[\\/]"/>

    <suppress checks="LineLength" files="target[\\/]"/>
    <suppress checks="LineLength" files="io[\\/]microraft[\\/]tutorial[\\/]"/>
    <suppress checks="LineLength" files="io[\\/]microraft[\\/]faulttolerance[\\/]"/>

    <suppress checks="FileLength|MethodCount|ClassFanOutComplexity|ClassDataAbstractionCoupling"
              files="io[\\/]microraft[\\/]impl[\\/]RaftNodeImpl"/>

    <!-- Suppress checks for tests -->
    <suppress checks="Javadoc|Name|MagicNumber|VisibilityModifier|MethodCount|NPathComplexity|LineLength|UnusedImports|DeclarationOrder"
              files="[\\/]src[\\/]test[\\/]"/>
    <suppress checks="Javadoc|Name|MagicNumber|VisibilityModifier|MethodCount|NPathComplexity|LineLength|UnusedImports|DeclarationOrder"
              files="[\\/]src[\\/]testFixtures[\\/]"/>

    <!-- Suppress selected legacy production violations -->
    <suppress checks="LineLength" files="io[\\/]microraft[\\/]HoconRaftConfigFields"/>
    <suppress checks="BooleanExpressionComplexity|LineLength" files="io[\\/]microraft[\\/]impl[\\/]RaftNodeBuilderImpl"/>
    <suppress checks="ParameterNumber|LineLength|WhitespaceAfter" files="io[\\/]microraft[\\/]impl[\\/]RaftNodeImpl"/>
    <suppress checks="CyclomaticComplexity|ReturnCount" files="io[\\/]microraft[\\/]impl[\\/]task[\\/]MembershipChangeTask"/>
    <suppress checks="ParameterNumber" files="io[\\/]microraft[\\/]impl[\\/]report[\\/]RaftNodeReportImpl"/>
    <suppress checks="ClassDataAbstractionCoupling" files="io[\\/]microraft[\\/]model[\\/]impl[\\/]DefaultRaftModelFactory"/>

    <!-- module-info.java -->
    <suppress checks="" files="[\\/]module-info"/>

</suppressions>
